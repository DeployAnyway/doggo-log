{
  "name": "@deployanyway/doggo-log",
  "version": "1.0.0",
  "description": "Node.js logs with async request context, JSON, levels and configurable redaction. Good logs. Very good logs. Fewer lost request IDs.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./context.d.ts",
        "default": "./src/context.js"
      },
      "require": {
        "types": "./context.d.cts",
        "default": "./dist/context.cjs"
      }
    }
  },
  "bin": {
    "doggo-log": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist",
    "index.d.ts",
    "index.d.cts",
    "MIGRATION.md",
    "context.d.ts",
    "context.d.cts",
    "examples"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "coverage": "c8 --all --include=src/**/*.js --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --lines=90 --statements=90 --functions=90 --branches=85 node --test test/*.test.js",
    "test:types": "tsc -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeployAnyway/doggo-log.git"
  },
  "bugs": {
    "url": "https://github.com/DeployAnyway/doggo-log/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "cli",
    "developer-tools",
    "logger",
    "logging",
    "console",
    "json",
    "log-levels",
    "dog",
    "typescript",
    "humor",
    "deployanyway",
    "async-local-storage",
    "request-id",
    "redaction"
  ],
  "main": "./dist/index.cjs",
  "types": "./index.d.ts",
  "homepage": "https://deployanyway.github.io/"
}
